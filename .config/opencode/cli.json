{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "keybinds": {
    "leader": "alt+space"
  },
  "session": {
    "thinking": "show"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "numbers"
  },
  "diffs": {
    "view": "split"
  },
  "terminal": {
    "copy": "select",
    "title": true
  },
  "prompt": {
    "paste": "full",
    "editor": true
  }
}
